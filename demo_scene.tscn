[sub_resource type="GDScript" id="GDScript_tap1b"]
script/source = "extends Node3D

@export var move_speed: float = 8.0
@export var fast_multiplier: float = 2.5
@export var mouse_sensitivity: float = 0.005
@export var key_rotate_speed: float = 90.0   # градусов/сек
@export var vertical_speed: float = 6.0

var _yaw: float = 0.0


func _ready() -> void:
	_yaw = rotation.y
	Input.mouse_mode = Input.MOUSE_MODE_CAPTURED


func _unhandled_input(event: InputEvent) -> void:
	if event is InputEventMouseMotion and Input.mouse_mode == Input.MOUSE_MODE_CAPTURED:
		_yaw -= event.relative.x * mouse_sensitivity
		_apply_rotation()

	if event is InputEventKey and event.pressed and event.keycode == KEY_ESCAPE:
		Input.mouse_mode = Input.MOUSE_MODE_VISIBLE
	elif event is InputEventMouseButton and event.pressed \\
			and event.button_index == MOUSE_BUTTON_LEFT \\
			and Input.mouse_mode != Input.MOUSE_MODE_CAPTURED:
		Input.mouse_mode = Input.MOUSE_MODE_CAPTURED


func _process(delta: float) -> void:
	# --- Вращение с клавиатуры (Q/E — влево/вправо) ---
	var yaw_input := 0.0
	if Input.is_physical_key_pressed(KEY_Q):
		yaw_input -= 1.0
	if Input.is_physical_key_pressed(KEY_E):
		yaw_input += 1.0

	if yaw_input != 0.0:
		_yaw -= deg_to_rad(key_rotate_speed) * yaw_input * delta
		_apply_rotation()

	# --- Перемещение (WASD) в плоскости XZ относительно yaw ---
	var move := Vector3.ZERO
	if Input.is_physical_key_pressed(KEY_W):
		move -= transform.basis.z
	if Input.is_physical_key_pressed(KEY_S):
		move += transform.basis.z
	if Input.is_physical_key_pressed(KEY_A):
		move -= transform.basis.x
	if Input.is_physical_key_pressed(KEY_D):
		move += transform.basis.x

	if move != Vector3.ZERO:
		move.y = 0.0
		move = move.normalized()
		var speed := move_speed
		if Input.is_physical_key_pressed(KEY_SHIFT):
			speed *= fast_multiplier
		global_position += move * speed * delta

	# --- Вертикаль: Space вверх, Ctrl вниз ---
	var vertical := 0.0
	if Input.is_physical_key_pressed(KEY_SPACE):
		vertical += 1.0
	if Input.is_physical_key_pressed(KEY_CTRL):
		vertical -= 1.0
	if vertical != 0.0:
		global_position.y += vertical * vertical_speed * delta


func _apply_rotation() -> void:
	rotation = Vector3(0.0, _yaw, 0.0)
"

